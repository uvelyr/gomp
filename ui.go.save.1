package main

import (
	"strconv"
	"github.com/gdamore/tcell/v2"
	"fmt"
)

func drawBox(box Box, screen tcell.Screen) {
	style := tcell.StyleDefault.Foreground(tcell.ColorWhite).Background(tcell.ColorBlack)

	startX, startY, width, height := box.startX, box.startY, box.width, box.height
	h := '─'
	v := '│'
	tl := '┌'
	tr := '┐'
	bl := '└'
	br := '┘'

	screen.SetContent(startX, startY, tl, nil, style)
	screen.SetContent(startX+width-1, startY, tr, nil, style)
	screen.SetContent(startX, startY+height-1, bl, nil, style)
	screen.SetContent(startX+width-1, startY+height-1, br, nil, style)

	for x := startX + 1; x < startX + width-1; x++ {
		screen.SetContent(x, startY, h, nil, style)
		screen.SetContent(x, startY+height-1, h, nil, style)
	}

	for y := startY + 1; y < startY+height-1; y++ {
		screen.SetContent(startX, y, v, nil, style)
		screen.SetContent(startX+width-1, y, v, nil, style)
	}
}

func (ui *UI) displaySongList(songs []Song, box Box, screen tcell.Screen) {
	style := tcell.StyleDefault.Foreground(tcell.ColorWhite).Background(tcell.ColorBlack)

	drawBox(box, screen)

	for i, song := range songs{
		y := box.startY + 1 + i
		if y >= box.startY+box.height-1 {
			break
		}
		line := strconv.Itoa(i+1)  + ": " + song.Name
		for x, ch := range line {
			if x >= box.width-2 {
				break
			}
			screen.SetContent(box.startX+1+x, y, ch, nil, style)
		}
	}

	screen.Show()
}

func (ui *UI) drawPlaybackBox() {
	drawBox(playbackBox, ui.screen)
	screen.Show()
}

func (ui *UI) updatePlaybackBox(pm *PlaybackManager) {
    box := playbackBox
	p := pm.player

	style := tcell.StyleDefault.Foreground(tcell.ColorWhite).Background(tcell.ColorBlack)

	// Coordinates inside the box
	x := box.startX + 1
	y := box.startY + 1
	width := box.width - 2

	// Current song
	var songName string
	if pm.currentSong != nil {
		songName = pm.currentSong.Name
	} else {
		songName = "No song"
	}
	if len(songName) > width {
		songName = songName[:width-1] + "…" // truncate with ellipsis
	}

	// Clear song name field first
	for i := 0; i < width; i++ {
		screen.SetContent(x+i, y, ' ', nil, style)
	}
	// Draw song name centered
	songX := x + (width-len(songName))/2
	for i, r := range songName {
		screen.SetContent(songX+i, y, r, nil, style)
	}

	// Status
	status := "⏹" // stopped
	if p.Control != nil {
		if p.Control.Paused {
			status = "⏸"
		} else {
			status = "▶"
		}
	}
	statusStr := "Status: " + status
	for i, r := range statusStr {
		screen.SetContent(x+i, y+1, r, nil, style)
	}

	// Speed
	speedVal := 1.0
	if p.Speed != nil {
		speedVal = p.Speed.Ratio()
	}
	speedStr := fmt.Sprintf("Speed: %.2fx", speedVal)
	for i, r := range speedStr {
		screen.SetContent(x+i, y+2, r, nil, style)
	}

	// Volume
	vol := 0.0
	if p.Volume != nil {
		vol = p.Volume.Volume
	}
	volStr := fmt.Sprintf("Vol: %.1f dB", vol)
	for i, r := range volStr {
		screen.SetContent(x+i, y+3, r, nil, style)
	}

	// Elapsed / total length
	var elapsed, totalSamples int
	if p.Streamer != nil {
		elapsed = p.Streamer.Position()
		totalSamples = p.Streamer.Len()
	}
	elapsedTime := formatDuration(elapsed, p.Format.SampleRate)
	totalTime := formatDuration(totalSamples, p.Format.SampleRate)
	timeStr := fmt.Sprintf("Time: %s / %s", elapsedTime, totalTime)
	for i, r := range timeStr {
		screen.SetContent(x+i, y+4, r, nil, style)
	}

	screen.Show()
}

func (ui *UI) drawSongSelectionBox() {
    box := songSelectionBox
	style := tcell.StyleDefault.Foreground(tcell.ColorWhite).Background(tcell.ColorBlack)

	startX, startY, width, height := box.startX, box.startY, box.width, box.height
	h := '─'
	v := '│'
	bl := '└'
	br := '┘'

	title := "Enter song id"
	titleRunes := []rune(title)
	titleLen := len(titleRunes)

	// left and right junctions
	screen.SetContent(startX, startY-1, '├', nil, style)
	screen.SetContent(startX+width-1, startY-1, '┤', nil, style)

	// horizontal line with text in the middle
	textStart := startX + (width-titleLen-2)/2 // -2 for spacing before and after
	for x := startX + 1; x < startX+width-1; x++ {
		switch {
		case x == textStart-1 || x == textStart+titleLen:
			// optional spacing around text
			screen.SetContent(x, startY-1, h, nil, style)
		case x >= textStart && x < textStart+titleLen:
			screen.SetContent(x, startY-1, titleRunes[x-textStart], nil, style)
		default:
			screen.SetContent(x, startY-1, h, nil, style)
		}
	}

	// bottom corners
	screen.SetContent(startX, startY+height-1, bl, nil, style)
	screen.SetContent(startX+width-1, startY+height-1, br, nil, style)

	// bottom horizontal line
	for x := startX + 1; x < startX+width-1; x++ {
		screen.SetContent(x, startY+height-1, h, nil, style)
	}

	// vertical sides
	for y := startY; y < startY+height-1; y++ {
		screen.SetContent(startX, y, v, nil, style)
		screen.SetContent(startX+width-1, y, v, nil, style)
	}

	screen.Show()
}

func (ui *UI) clearSongSelectionBox(screen tcell.Screen) {
    box := songSelectionBox
	style := tcell.StyleDefault.Foreground(tcell.ColorWhite).Background(tcell.ColorBlack)

	startX, startY, width, height := box.startX, box.startY, box.width, box.height

	for y := startY; y < startY+height; y ++ {
		for x := startX; x < startX+width; x++ {
			screen.SetContent(x, y, ' ', nil, style)
		}
	}

	//return last box line of songList to normal condition
	for x := startX+1; x < startX + width - 1; x ++ {
		screen.SetContent(x, startY-1, '─', nil, style)
	}
	screen.SetContent(startX, startY-1, '└', nil, style)
	screen.SetContent(startX+width-1, startY-1, '┘', nil, style)
}

func (ui *UI) selectSong(field Field, allSongs []Song, keyPressChan <-chan KeyPress) Song {
	var input []rune

	updateInputField := func() {
		// clear field
		for x := 0; x < field.width; x++ {
			screen.SetContent(field.startX+x, field.startY, ' ', nil, tcell.StyleDefault)
		}

		// draw digits
		for i, r := range input {
			screen.SetContent(field.startX+i, field.startY, r, nil, tcell.StyleDefault)
		}

		screen.Show()
	}

	for ev := range keyPressChan {
		switch ev.Key {

		case tcell.KeyEnter:
			if len(input) == 0 {
				input = nil
				updateInputField()
				return Song{}
			}
			n, err := strconv.Atoi(string(input))
			if err != nil || n < 1 || n > len(allSongs) {
				msg := "Invalid id"
				style := tcell.StyleDefault.Foreground(tcell.ColorGray)
				for i, r := range msg {
					screen.SetContent(field.startX+i, field.startY, r, nil, style)
				}
				screen.Show()

				input = nil
				updateInputField()
				continue
			}
			return allSongs[n-1]
		case tcell.KeyBackspace, tcell.KeyBackspace2:
			if len(input) > 0 {
				input = input[:len(input)-1]
				updateInputField()
			}
		case tcell.KeyEsc:
			//return empty to indicate that we're leaving song selection mode
			return Song{}

		case tcell.KeyRune:
			r := ev.Rune
			if r >= '0' && r <= '9' {
				input = append(input, r)
				updateInputField()
			}
		}
	}

	return Song{}
}

type UI struct {
    screen tcell.Screen
    keyPressChan <-chan KeyPress
    songs []Song
}

func NewUI(screen tcell.Screen, keyPressChan <-chan KeyPress, songs []Song) *UI{
    return UI{
        screen: tcell.Screen,
        keyPressChan: keyPressChan,
        songs: songs,
    }
}

func (ui *UI) start() {
    ui.startRawInputLoop()
    ui.displaySongList(allSongs, songListBox, screen)
    ui.drawPlaybackBox(playbackBox, screen)
    ui.runUILoop()
} 

func (ui *UI) runUILoop() {
  for {
	    select {
	    case <- cmdHandler.requestSongSelectionChan:
		    drawSongSelectionBox(songSelectionBox, screen)
		    selectedSong := selectSong(screen, songSelectionField, allSongs, songSelectionChan)
		    clearSongSelectionBox(songSelectionBox, screen)
		    cmdHandler.songSelectedChan <- selectedSong
	    case <- cmdHandler.requestPlaybackBoxUpdateChan:
		    updatePlaybackBox(playbackBox, screen, playbackManager)
	    }
    }
}

func (ui *UI) startRawInputLoop() {
    go func() {
		for {
			ev := screen.PollEvent()

			switch e := ev.(type) {
			case *tcell.EventKey:
				keyPressChan <- KeyPress{Rune: e.Rune(), Key: e.Key()}
			case *tcell.EventResize:
			}
		}
	}()
}
